          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbeille"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓"
          }
        }
      }
    },
    "Trash, Mail, Safari and iOS backups can be scanned.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierkorb, Mail, Safari und iOS-Backups können gescannt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden analizar la Papelera, Mail, Safari y las copias de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Corbeille, Mail, Safari et les sauvegardes iOS peuvent être analysés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱、メール、Safari、iOS バックアップをスキャンできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以扫描废纸篓、邮件、Safari 和 iOS 备份。"
          }
        }
      }
    },
    "Trash, Mail, Safari and iOS backups can only be scanned with Full Disk Access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierkorb, Mail, Safari und iOS-Backups lassen sich nur mit Festplattenvollzugriff scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Papelera, Mail, Safari y las copias de iOS solo se pueden analizar con Acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Corbeille, Mail, Safari et les sauvegardes iOS ne peuvent être analysés qu’avec l’Accès complet au disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱、メール、Safari、iOS バックアップは、フルディスクアクセスがある場合のみスキャンできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有获得完全磁盘访问权限后才能扫描废纸篓、邮件、Safari 和 iOS 备份。"
          }
        }
      }
    },
    "Trash, Mail, Safari and iOS backups live in folders macOS protects. OpenClean only reads what its cleaning rules list, and never sends anything off your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierkorb, Mail, Safari und iOS-Backups liegen in Ordnern, die macOS schützt. OpenClean liest nur, was seine Bereinigungsregeln aufführen, und sendet nie etwas von deinem Mac weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Papelera, Mail, Safari y las copias de iOS están en carpetas que macOS protege. OpenClean solo lee lo que indican sus reglas de limpieza y nunca envía nada fuera de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Corbeille, Mail, Safari et les sauvegardes iOS se trouvent dans des dossiers protégés par macOS. OpenClean ne lit que ce que ses règles de nettoyage indiquent et n’envoie jamais rien hors de votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱、メール、Safari、iOS バックアップは macOS が保護するフォルダにあります。OpenClean はクリーンアップルールに記載されたものだけを読み取り、Mac の外に何かを送信することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓、邮件、Safari 和 iOS 备份位于受 macOS 保护的文件夹中。OpenClean 只读取其清理规则列出的内容，绝不会将任何内容发送到 Mac 之外。"
          }
        }
      }
    },
