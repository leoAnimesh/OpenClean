    },
    "The app could not be moved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte nicht bewegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mover la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas pu être déplacée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App を移動できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移动该 App。"
          }
        }
      }
    },
    "The app itself is always included": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App selbst ist immer dabei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propia app siempre se incluye"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app elle-même est toujours incluse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App 本体は常に含まれます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 本身始终包括在内"
          }
        }
      }
    },
    "The command finished without errors.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl wurde ohne Fehler beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando terminó sin errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande s’est terminée sans erreur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドはエラーなく完了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令已完成，没有错误。"
          }
        }
      }
    },
    "The menu bar monitor only samples while it shows a figure or its window is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menüleistenanzeige misst nur, während sie einen Wert zeigt oder ihr Fenster geöffnet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El monitor de la barra de menús solo toma muestras mientras muestra una cifra o su ventana está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moniteur de la barre des menus ne mesure que lorsqu’il affiche un chiffre ou que sa fenêtre est ouverte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのモニタは、数値を表示しているときかウインドウが開いているときだけ計測します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏监视器仅在显示数值或其窗口打开时采样。"
          }
        }
      }
    },
    "The result shows only in the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis erscheint nur in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado solo se muestra en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat s’affiche uniquement dans la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果はメニューバーにだけ表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果只会显示在菜单栏中。"
          }
        }
      }
    },
    "The scan was stopped early. Results are partial.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan wurde vorzeitig gestoppt. Die Ergebnisse sind unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se detuvo antes de tiempo. Los resultados son parciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse a été arrêtée avant la fin. Les résultats sont partiels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンは途中で停止しました。結果は一部のみです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描提前停止。结果不完整。"
          }
        }
      }
    },
    "The scan was stopped early. Sizes are partial.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan wurde vorzeitig gestoppt. Die Größen sind unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se detuvo antes de tiempo. Los tamaños son parciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse a été arrêtée avant la fin. Les tailles sont partielles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンは途中で停止しました。サイズは一部のみです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描提前停止。大小不完整。"
          }
        }
      }
    },
    "The update didn't finish": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update wurde nicht abgeschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no terminó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour ne s’est pas terminée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートは完了しませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新未完成"
          }
        }
      }
    },
    "These apps carry their own login items. macOS decides whether they run; turn them on or off in System Settings → General → Login Items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Apps bringen eigene Anmeldeobjekte mit. macOS entscheidet, ob sie laufen; schalte sie in Systemeinstellungen → Allgemein → Anmeldeobjekte ein oder aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas apps incluyen sus propios ítems de inicio. macOS decide si se ejecutan; actívalos o desactívalos en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces apps ont leurs propres éléments d’ouverture. macOS décide s’ils s’exécutent ; activez-les ou désactivez-les dans Réglages Système → Général → Ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの App は独自のログイン項目を持っています。実行するかどうかは macOS が決めます。オン・オフはシステム設定 → 一般 → ログイン項目で切り替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 App 自带登录项。是否运行由 macOS 决定；请在“系统设置”→“通用”→“登录项”中打开或关闭。"
          }
        }
      }
    },
    "These items move to quarantine. You can restore them from History for %lld days; after that they are deleted.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Diese Objekte kommen in die Quarantäne. Du kannst sie %lld Tag lang aus dem Verlauf wiederherstellen; danach werden sie gelöscht."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Diese Objekte kommen in die Quarantäne. Du kannst sie %lld Tage lang aus dem Verlauf wiederherstellen; danach werden sie gelöscht."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "These items move to quarantine. You can restore them from History for %lld day; after that they are deleted."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "These items move to quarantine. You can restore them from History for %lld days; after that they are deleted."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Estos ítems van a cuarentena. Puedes restaurarlos desde el Historial durante %lld día; después se eliminan."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Estos ítems van a cuarentena. Puedes restaurarlos desde el Historial durante %lld días; después se eliminan."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ces éléments vont en quarantaine. Vous pouvez les restaurer depuis l’Historique pendant %lld jour ; ensuite, ils sont supprimés."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ces éléments vont en quarantaine. Vous pouvez les restaurer depuis l’Historique pendant %lld jours ; ensuite, ils sont supprimés."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "これらの項目は隔離へ移動します。%lld 日間は履歴から復元でき、その後は削除されます。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "这些项目会移入隔离区。你可以在 %lld 天内从“历史记录”恢复它们；之后它们将被删除。"
                }
              }
            }
          }
        }
      }
    },
    "Thin Time Machine local snapshots": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Time Machine-Snapshots ausdünnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir las instantáneas locales de Time Machine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les instantanés locaux Time Machine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine のローカルスナップショットを削減"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精简 Time Machine 本地快照"
          }
        }
      }
    },
    "This build of OpenClean has a new signature, so macOS no longer recognises the earlier permission. Remove OpenClean from the list in Settings, add it again, then click Check Again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build von OpenClean hat eine neue Signatur, daher erkennt macOS die frühere Berechtigung nicht mehr. Entferne OpenClean in den Einstellungen aus der Liste, füge es erneut hinzu und klicke dann auf „Erneut prüfen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación de OpenClean tiene una firma nueva, así que macOS ya no reconoce el permiso anterior. Quita OpenClean de la lista en Ajustes, vuelve a añadirlo y haz clic en Comprobar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d’OpenClean a une nouvelle signature : macOS ne reconnaît donc plus l’autorisation précédente. Retirez OpenClean de la liste dans les Réglages, ajoutez-le à nouveau, puis cliquez sur Vérifier à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドの OpenClean は署名が新しいため、macOS は以前の許可を認識しなくなりました。設定のリストから OpenClean を削除してもう一度追加し、「再確認」をクリックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 OpenClean 签名已更改，macOS 不再识别之前的权限。请在“设置”的列表中移除 OpenClean，重新添加，然后点按“再次检查”。"
          }
        }
      }
    },
    "This can take a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann eine Minute dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede tardar un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut prendre une minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分ほどかかる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可能需要一分钟。"
          }
        }
      }
    },
    "This folder is deep in the map, so its contents were summarized.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner liegt tief in der Karte, daher wurde sein Inhalt zusammengefasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta está muy dentro del mapa, así que su contenido se ha resumido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est profond dans la carte, son contenu a donc été résumé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダはマップの深い階層にあるため、中身はまとめて表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹在地图中层级很深，因此其内容已被汇总。"
          }
        }
      }
    },
    "This is OpenClean itself": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist OpenClean selbst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el propio OpenClean"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est OpenClean lui-même"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは OpenClean 自身です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 OpenClean 本身"
          }
        }
      }
    },
    "This release can't be installed from inside OpenClean. Download it from GitHub instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version kann nicht aus OpenClean heraus installiert werden. Lade sie stattdessen von GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no se puede instalar desde OpenClean. Descárgala de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne peut pas être installée depuis OpenClean. Téléchargez-la plutôt depuis GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースは OpenClean 内からはインストールできません。代わりに GitHub からダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法在 OpenClean 内安装。请改为从 GitHub 下载。"
          }
        }
      }
    },
    "Tick a category to clean it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake eine Kategorie an, um sie zu bereinigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una categoría para limpiarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez une catégorie pour la nettoyer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップするカテゴリにチェックを入れてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选类别即可清理"
          }
        }
      }
    },
    "Tick items to move them": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake Objekte an, um sie zu bewegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca ítems para moverlos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez des éléments pour les déplacer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動する項目にチェックを入れてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选项目即可移动"
          }
        }
      }
    },
    "Tick the copies you don’t need; they go to the Trash. One copy of each file always stays, and nothing is picked for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake die Kopien an, die du nicht brauchst; sie kommen in den Papierkorb. Eine Kopie jeder Datei bleibt immer erhalten, und nichts wird für dich ausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca las copias que no necesites; irán a la Papelera. Siempre se conserva una copia de cada archivo y no se elige nada por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les copies dont vous n’avez pas besoin ; elles iront dans la Corbeille. Une copie de chaque fichier est toujours conservée, et rien n’est choisi pour vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不要なコピーにチェックを入れると、ゴミ箱に入ります。各ファイルのコピーは必ずひとつ残り、自動で選択されるものはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选你不需要的副本，它们会进入废纸篓。每个文件总会保留一份副本，不会替你选择任何项目。"
          }
        }
      }
    },
    "Today, %@": {
