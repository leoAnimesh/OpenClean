    "Your Mac is %@ lighter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac ist %@ leichter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac tiene %@ menos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac est allégé de %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac が %@ 軽くなりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 减轻了 %@"
          }
        }
      }
    },
    "Your current version is kept in History, so you can go back to it. After OpenClean restarts, macOS will ask you to allow Full Disk Access again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuelle Version bleibt im Verlauf, sodass du zu ihr zurückkehren kannst. Nach dem Neustart von OpenClean fragt macOS erneut nach dem Festplattenvollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu versión actual se guarda en el Historial para que puedas volver a ella. Cuando OpenClean se reinicie, macOS te pedirá que vuelvas a permitir el Acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre version actuelle est conservée dans l’Historique pour que vous puissiez y revenir. Après le redémarrage d’OpenClean, macOS vous demandera d’autoriser à nouveau l’Accès complet au disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンは履歴に保存されるので、元に戻せます。OpenClean の再起動後、macOS がフルディスクアクセスをもう一度許可するよう求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本会保留在“历史记录”中，因此你可以回退。OpenClean 重新启动后，macOS 会要求你再次允许完全磁盘访问权限。"
          }
        }
      }
    },
    "Your launch agents": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Startagents"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes de inicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
