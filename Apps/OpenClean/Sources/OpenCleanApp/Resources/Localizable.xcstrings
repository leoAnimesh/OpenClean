{
  "sourceLanguage": "en",
  "strings": {
    "%@ + %@ to quarantine": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ + %2$@ in die Quarantäne"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ + %2$@ a cuarentena"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ + %2$@ en quarantaine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ + %2$@ を隔離へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ + %2$@ 移入隔离区"
          }
        }
      }
    },
    "%@ Scan again to pick them up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Scanne erneut, um sie zu erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vuelve a analizar para incluirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Relancez l’analyse pour les reprendre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ もう一度スキャンすると対象になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 重新扫描即可将它们纳入。"
          }
        }
      }
    },
    "%@ can only be scanned with Full Disk Access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nur mit Festplattenvollzugriff gescannt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo se puede analizar con Acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut être analysé qu’avec l’Accès complet au disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はフルディスクアクセスがある場合のみスキャンできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只有在获得“完全磁盘访问权限”后才能扫描。"
          }
        }
      }
    },
    "%@ can't be force quit from OpenClean.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht aus OpenClean sofort beendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se puede forzar a salir desde OpenClean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de forcer %@ à quitter depuis OpenClean."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は OpenClean から強制終了できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 OpenClean 强制退出 %@。"
          }
        }
      }
    },
    "%@ can't be quit from OpenClean.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht aus OpenClean beendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se puede cerrar desde OpenClean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de quitter %@ depuis OpenClean."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は OpenClean から終了できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 OpenClean 退出 %@。"
          }
        }
      }
    },
    "%@ could not be force quit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht sofort beendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo forzar la salida de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de forcer %@ à quitter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を強制終了できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法强制退出 %@。"
          }
        }
      }
    },
    "%@ didn't accept the request to quit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Aufforderung zum Beenden nicht angenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no aceptó la solicitud de cierre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté la demande de fermeture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は終了の要求を受け付けませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未接受退出请求。"
          }
        }
      }
    },
    "%@ didn't quit. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht beendet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se cerró. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas quitté. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は終了しませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未退出。请重试。"
          }
        }
      }
    },
    "%@ didn’t finish": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht abgeschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no terminó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne s’est pas terminé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は完了しませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未完成"
          }
        }
      }
    },
    "%@ each": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "je %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cada una"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chacune"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 %@"
          }
        }
      }
    },
    "%@ extra": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zusätzlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en trop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "余分 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多余 %@"
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ frei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libres"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@"
          }
        }
      }
    },
    "%@ freed by OpenClean": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ von OpenClean freigegeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liberados por OpenClean"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libérés par OpenClean"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean が %@ を解放"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 已释放 %@"
          }
        }
      }
    },
    "%@ freed now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sofort freigegeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liberados ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ libérés maintenant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ %@ を解放"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即释放 %@"
          }
        }
      }
    },
    "%@ had already quit or changed, so nothing was done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war bereits beendet oder hat sich geändert, daher wurde nichts getan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya se había cerrado o cambiado, así que no se hizo nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avait déjà quitté ou changé, rien n’a donc été fait."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに終了しているか変更されていたため、何もしませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出或已变化，因此未执行任何操作。"
          }
        }
      }
    },
    "%@ in /Library stay in place (needs administrator — not supported yet).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in /Library bleiben, wo sie sind (benötigt Administratorrechte – noch nicht unterstützt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en /Library se quedan donde están (requiere administrador; aún no compatible)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dans /Library restent en place (nécessite un administrateur — pas encore pris en charge)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/Library 内の %@ はそのまま残ります（管理者権限が必要なため、まだ対応していません）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "/Library 中的 %@ 保留原处（需要管理员权限，尚不支持）。"
          }
        }
      }
    },
    "%@ in quarantine": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in Quarantäne"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en cuarentena"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en quarantaine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隔離中 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔离区中 %@"
          }
        }
      }
    },
    "%@ in quarantine for %lld days. Restore it from History.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ für %#@days@ in Quarantäne. Stelle es aus dem Verlauf wieder her."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tage"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in quarantine for %#@days@. Restore it from History."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en cuarentena durante %#@days@. Restáuralo desde el Historial."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg día"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en quarantaine pendant %#@days@. Restaurez-le depuis l’Historique."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg jour"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg jours"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を %#@days@隔離しています。履歴から復元できます。"
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 日間"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在隔离区保留 %#@days@。可从“历史记录”恢复。"
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 天"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ in total. You can put items back from the Trash in Finder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insgesamt %@. Du kannst Objekte im Finder aus dem Papierkorb zurücklegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en total. Puedes devolver los ítems desde la Papelera en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ au total. Vous pouvez remettre les éléments en place depuis la Corbeille dans le Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計 %@。Finder でゴミ箱から元に戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %@。你可以在访达中从废纸篓放回项目。"
          }
        }
      }
    },
    "%@ is owned by the system. macOS will ask for your administrator password to move it to quarantine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört dem System. macOS fragt nach deinem Administratorpasswort, um es in die Quarantäne zu bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pertenece al sistema. macOS te pedirá la contraseña de administrador para moverla a cuarentena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appartient au système. macOS vous demandera votre mot de passe administrateur pour le placer en quarantaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はシステムが所有しています。隔離へ移動するために、macOS が管理者パスワードを求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 归系统所有。macOS 会要求输入管理员密码，才能将它移入隔离区。"
          }
        }
      }
    },
    "%@ is running. Quit it to uninstall.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist geöffnet. Beende die App, um sie zu deinstallieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se está ejecutando. Ciérrala para desinstalarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours d’exécution. Quittez-la pour la désinstaller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は実行中です。アンインストールするには終了してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行。请先退出再卸载。"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ of %@ checks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ Prüfungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ comprobaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vérifications sur %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 件中 %1$@ 件を確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检查 %1$@ / %2$@"
          }
        }
      }
    },
    "%@ of shared memory": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ des gemeinsamen Speichers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de memoria compartida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de mémoire partagée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有メモリ %@"
          }
        },
        "zh-Hans": {
