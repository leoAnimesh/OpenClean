    },
    "You’ll see its size, its leftovers in your Library, and what would move to quarantine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst ihre Größe, ihre Reste in deiner Library und was in die Quarantäne kommen würde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verás su tamaño, sus restos en tu Library y lo que iría a cuarentena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous verrez sa taille, ses restes dans votre Library et ce qui irait en quarantaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ、ライブラリ内の残りファイル、隔離へ移動するものが表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将看到它的大小、它在资源库中的残留文件，以及将移入隔离区的内容。"
          }
        }
      }
    },
