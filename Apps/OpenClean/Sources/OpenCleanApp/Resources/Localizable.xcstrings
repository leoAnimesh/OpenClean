    "You can switch to other screens while this runs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst währenddessen zu anderen Bereichen wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar a otras pantallas mientras se ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer à d’autres écrans pendant ce temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中もほかの画面に切り替えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行期间你可以切换到其他界面。"
          }
        }
      }
    },
    "You have %@. Your current version stays in History after updating.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@. Deine aktuelle Version bleibt nach dem Update im Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la %@. Tu versión actual se queda en el Historial tras actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la %@. Votre version actuelle reste dans l’Historique après la mise à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンは %@ です。アップデート後も現在のバージョンは履歴に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你当前使用的是 %@。更新后，当前版本会保留在“历史记录”中。"
          }
        }
      }
    },
    "You're all set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bereit"
          }
        },
        "es": {
