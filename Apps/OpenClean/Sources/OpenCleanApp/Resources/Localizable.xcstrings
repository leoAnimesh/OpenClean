    "Tasks marked “Needs admin” ask for your password once per run. OpenClean can only run these exact commands as administrator.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Admin nötig“ markierte Aufgaben fragen bei jeder Ausführung einmal nach deinem Passwort. OpenClean kann nur genau diese Befehle als Administrator ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas marcadas con “Requiere administrador” piden tu contraseña una vez por ejecución. OpenClean solo puede ejecutar estos comandos exactos como administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches marquées « Admin requis » demandent votre mot de passe une fois par exécution. OpenClean ne peut exécuter en tant qu’administrateur que ces commandes précises."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「管理者権限が必要」と表示されたタスクは、実行のたびにパスワードを 1 回求めます。OpenClean が管理者として実行できるのは、これらの決まったコマンドだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标有“需要管理员”的任务每次运行时会询问一次密码。OpenClean 只能以管理员身份运行这些确切的命令。"
          }
        }
      }
    },
    "The GPU has no memory of its own. It uses the same %@ as your apps, up to about %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GPU hat keinen eigenen Speicher. Sie nutzt dieselben %1$@ wie deine Apps, bis zu etwa %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La GPU no tiene memoria propia. Usa los mismos %1$@ que tus apps, hasta unos %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPU n’a pas de mémoire à lui. Il utilise les mêmes %1$@ que vos apps, jusqu’à environ %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU には専用のメモリがありません。App と同じ %1$@ を、最大でおよそ %2$@ まで使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU 没有自己的内存。它与 App 共用同样的 %1$@，最多约 %2$@。"
          }
        }
      }
    },
    "The GPU has no memory of its own. It uses the same %@ as your apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GPU hat keinen eigenen Speicher. Sie nutzt dieselben %@ wie deine Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La GPU no tiene memoria propia. Usa los mismos %@ que tus apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPU n’a pas de mémoire à lui. Il utilise les mêmes %@ que vos apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU には専用のメモリがありません。App と同じ %@ を使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU 没有自己的内存。它与 App 共用同样的 %@。"
          }
        }
      }
    },
    "The app": {
      "localizations": {
        "de": {
