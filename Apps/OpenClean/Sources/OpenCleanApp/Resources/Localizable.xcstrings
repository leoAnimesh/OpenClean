    "Asking GitHub for the latest release.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub wird nach der neuesten Version gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultando a GitHub la última versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de la dernière version sur GitHub."
          }
