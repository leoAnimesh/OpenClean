    "Sizes are space on disk. Copies made by APFS cloning may share space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größen sind belegter Speicherplatz. Durch APFS-Klonen erstellte Kopien können sich Speicherplatz teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tamaños son espacio en disco. Las copias creadas por clonación APFS pueden compartir espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tailles correspondent à l’espace disque. Les copies créées par clonage APFS peuvent partager de l’espace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズはディスク上の使用量です。APFS のクローンで作成されたコピーは領域を共有している場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小指磁盘占用空间。通过 APFS 克隆生成的副本可能共享空间。"
          }
        }
      }
    },
