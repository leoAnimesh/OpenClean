          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        }
      }
    },
    "Files from Documents or Desktop are moved only because you ticked each one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien aus „Dokumente“ oder „Schreibtisch“ werden nur bewegt, weil du jede einzeln angehakt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de Documentos o Escritorio solo se mueven porque has marcado cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de Documents ou du Bureau ne sont déplacés que parce que vous les avez cochés un par un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類またはデスクトップのファイルは、ひとつずつチェックを入れたものだけが移動されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“文稿”或“桌面”中的文件只有在你逐个勾选后才会被移走。"
          }
        }
      }
    },
    "Files that changed since the scan or are in use are skipped automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die sich seit dem Scan geändert haben oder in Benutzung sind, werden automatisch übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que han cambiado desde el análisis o están en uso se omiten automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers modifiés depuis l’analyse ou en cours d’utilisation sont ignorés automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン後に変更されたファイルや使用中のファイルは自動的にスキップされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自扫描后已更改或正在使用的文件会被自动跳过。"
          }
        }
      }
    },
    "Files that changed since the scan, or are open in another app, are skipped automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die sich seit dem Scan geändert haben oder in einer anderen App geöffnet sind, werden automatisch übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que han cambiado desde el análisis o están abiertos en otra app se omiten automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers modifiés depuis l’analyse ou ouverts dans une autre app sont ignorés automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン後に変更されたファイルや、ほかの App で開いているファイルは自動的にスキップされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自扫描后已更改或在其他 App 中打开的文件会被自动跳过。"
          }
        }
      }
    },
    "Files that couldn’t be read": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht lesbare Dateien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos que no se pudieron leer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers illisibles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れなかったファイル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取的文件"
          }
        }
      }
    },
    "Files there can be moved to the Trash only one at a time, by ticking each file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien dort können nur einzeln in den Papierkorb bewegt werden, indem du jede Datei anhakst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de ahí solo se pueden mover a la Papelera de uno en uno, marcando cada archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers qui s’y trouvent ne peuvent être placés dans la Corbeille qu’un par un, en cochant chaque fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこにあるファイルは、ひとつずつチェックを入れた場合にのみゴミ箱に入れられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那里的文件只能逐个勾选后移到废纸篓。"
          }
        }
      }
    },
    "Files under 1 MB, apps and ~/Library are skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien unter 1 MB, Apps und ~/Library werden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omiten los archivos de menos de 1 MB, las apps y ~/Library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de moins de 1 Mo, les apps et ~/Library sont ignorés."
          }
        },
