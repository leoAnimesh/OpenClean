    "OpenClean %@ is available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ ist verfügbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ está disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ est disponible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ が利用可能です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ 现已推出"
          }
        }
      }
    },
    "OpenClean %@ is available — you have %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %1$@ ist verfügbar – du hast %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %1$@ está disponible; tienes la %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %1$@ est disponible — vous avez la %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %1$@ が利用可能です（現在のバージョンは %2$@）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %1$@ 现已推出 — 你当前使用的是 %2$@。"
          }
        }
      }
    },
    "OpenClean %@ is the newest version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ ist die neueste Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ es la versión más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ est la version la plus récente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ は最新バージョンです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean %@ 是最新版本。"
          }
        }
      }
    },
    "OpenClean asks api.github.com once a day whether a newer release exists, and downloads updates only from GitHub. Nothing about you is sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean fragt einmal täglich bei api.github.com nach, ob es eine neuere Version gibt, und lädt Updates nur von GitHub. Über dich wird nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean pregunta a api.github.com una vez al día si hay una versión más reciente y solo descarga actualizaciones de GitHub. No se envía nada sobre ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean demande une fois par jour à api.github.com s’il existe une version plus récente et ne télécharge les mises à jour que depuis GitHub. Rien vous concernant n’est envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean は 1 日に 1 回 api.github.com に新しいリリースがあるかを問い合わせ、アップデートは GitHub からのみダウンロードします。あなたに関する情報は一切送信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 每天向 api.github.com 查询一次是否有新版本，并且只从 GitHub 下载更新。不会发送任何关于你的信息。"
          }
        }
      }
    },
    "OpenClean couldn’t read this folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean konnte diesen Ordner nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean no pudo leer esta carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean n’a pas pu lire ce dossier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean はこのフォルダを読み取れませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 无法读取此文件夹。"
          }
        }
      }
    },
    "OpenClean finds an app's caches, preferences, containers and launch agents by its exact bundle ID. The whole uninstall goes to quarantine, so it can be restored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean findet Caches, Einstellungen, Container und Startagents einer App anhand ihrer exakten Bundle-ID. Die gesamte Deinstallation kommt in die Quarantäne und kann wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean encuentra las cachés, preferencias, contenedores y agentes de inicio de una app por su ID de paquete exacto. Toda la desinstalación va a cuarentena, así que se puede restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean trouve les caches, préférences, conteneurs et agents de lancement d’une app grâce à son ID de paquet exact. Toute la désinstallation va en quarantaine et peut donc être restaurée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean は App のキャッシュ、環境設定、コンテナ、起動エージェントを正確なバンドル ID で見つけます。アンインストールしたものはすべて隔離へ移動するため、復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 根据 App 的确切包 ID 找到其缓存、偏好设置、容器和启动代理。整个卸载内容都会移入隔离区，因此可以恢复。"
          }
        }
      }
    },
    "OpenClean lists your apps with their sizes. Nothing is removed until you confirm, and uninstalled apps can be restored from History.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean listet deine Apps mit ihrer Größe auf. Nichts wird entfernt, bevor du bestätigst, und deinstallierte Apps lassen sich aus dem Verlauf wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean muestra tus apps con su tamaño. No se elimina nada hasta que lo confirmes, y las apps desinstaladas se pueden restaurar desde el Historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean liste vos apps avec leur taille. Rien n’est supprimé avant votre confirmation, et les apps désinstallées peuvent être restaurées depuis l’Historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean は App をサイズとともに一覧表示します。確認するまで何も削除されず、アンインストールした App は履歴から復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 会列出你的 App 及其大小。在你确认之前不会移除任何内容，已卸载的 App 可以从“历史记录”中恢复。"
          }
        }
      }
    },
    "OpenClean looks for old projects in your home folder, but never in Documents or Desktop. Add a folder where you keep code, such as Documents/Code, to search it too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean sucht alte Projekte in deinem Benutzerordner, aber nie in „Dokumente“ oder „Schreibtisch“. Füge einen Ordner hinzu, in dem du Code aufbewahrst, etwa Dokumente/Code, damit er ebenfalls durchsucht wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean busca proyectos antiguos en tu carpeta de inicio, pero nunca en Documentos ni en el Escritorio. Añade una carpeta donde guardes código, como Documentos/Code, para que también se busque en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean cherche les anciens projets dans votre dossier de départ, mais jamais dans Documents ni sur le Bureau. Ajoutez un dossier où vous gardez du code, comme Documents/Code, pour qu’il soit aussi examiné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean はホームフォルダで古いプロジェクトを探しますが、書類とデスクトップは対象にしません。コードを保管しているフォルダ（書類/Code など）を追加すると、そこも検索します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 会在你的个人文件夹中查找旧项目，但绝不会查找“文稿”或“桌面”。添加你存放代码的文件夹（例如 文稿/Code）即可一并搜索。"
          }
        }
      }
    },
    "OpenClean only offers Quit for apps, never for macOS components or itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean bietet „Beenden“ nur für Apps an, nie für macOS-Komponenten oder sich selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean solo ofrece Salir para apps, nunca para componentes de macOS ni para sí mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean ne propose Quitter que pour les apps, jamais pour les composants de macOS ni pour lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean が「終了」を表示するのは App だけで、macOS のコンポーネントや OpenClean 自身には表示しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 只为 App 提供“退出”，绝不会为 macOS 组件或它自身提供。"
          }
        }
      }
    },
    "OpenClean stops the agent and moves its file to quarantine. You can restore it from History for %lld days; it starts again at your next login after restoring.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean stoppt den Agent und bewegt seine Datei in die Quarantäne. Du kannst sie %lld Tag lang aus dem Verlauf wiederherstellen; nach dem Wiederherstellen startet er bei der nächsten Anmeldung wieder."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean stoppt den Agent und bewegt seine Datei in die Quarantäne. Du kannst sie %lld Tage lang aus dem Verlauf wiederherstellen; nach dem Wiederherstellen startet er bei der nächsten Anmeldung wieder."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean stops the agent and moves its file to quarantine. You can restore it from History for %lld day; it starts again at your next login after restoring."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean stops the agent and moves its file to quarantine. You can restore it from History for %lld days; it starts again at your next login after restoring."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean detiene el agente y mueve su archivo a cuarentena. Puedes restaurarlo desde el Historial durante %lld día; tras restaurarlo, se inicia de nuevo en tu próximo inicio de sesión."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean detiene el agente y mueve su archivo a cuarentena. Puedes restaurarlo desde el Historial durante %lld días; tras restaurarlo, se inicia de nuevo en tu próximo inicio de sesión."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean arrête l’agent et place son fichier en quarantaine. Vous pouvez le restaurer depuis l’Historique pendant %lld jour ; une fois restauré, il redémarre à votre prochaine ouverture de session."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean arrête l’agent et place son fichier en quarantaine. Vous pouvez le restaurer depuis l’Historique pendant %lld jours ; une fois restauré, il redémarre à votre prochaine ouverture de session."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean はエージェントを停止し、ファイルを隔離へ移動します。%lld 日間は履歴から復元でき、復元後は次回のログイン時に再び起動します。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "OpenClean 会停止该代理并将其文件移入隔离区。你可以在 %lld 天内从“历史记录”恢复它；恢复后，它会在你下次登录时再次启动。"
                }
              }
            }
          }
        }
      }
    },
    "OpenClean was updated. Allow Full Disk Access again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean wurde aktualisiert. Erlaube den Festplattenvollzugriff erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean se ha actualizado. Vuelve a permitir el Acceso total al disco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean a été mis à jour. Autorisez à nouveau l’Accès complet au disque"
          }
        },
        "ja": {
          "stringUnit": {
