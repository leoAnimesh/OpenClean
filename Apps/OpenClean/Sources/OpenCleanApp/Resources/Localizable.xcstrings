    },
    "Asks macOS to remove the local Time Machine snapshots it can drop to free space. Backups on your backup disk are not touched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittet macOS, die lokalen Time Machine-Snapshots zu entfernen, auf die es verzichten kann, um Speicherplatz freizugeben. Backups auf deinem Backup-Volume bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a macOS que elimine las instantáneas locales de Time Machine que puede descartar para liberar espacio. Las copias del disco de copia de seguridad no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à macOS de supprimer les instantanés locaux Time Machine dont il peut se passer pour libérer de l’espace. Les sauvegardes sur votre disque de sauvegarde ne sont pas touchées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き領域を増やすために、macOS が手放せるローカルの Time Machine スナップショットの削除を macOS に依頼します。バックアップディスク上のバックアップには触れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请 macOS 移除它可以舍弃的本地 Time Machine 快照以释放空间。备份磁盘上的备份不受影响。"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "de": {
