    "Off. Nothing runs in the background.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Im Hintergrund läuft nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. No se ejecuta nada en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Rien ne s’exécute en arrière-plan."
          }
