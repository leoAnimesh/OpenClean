    "Also found in /Library": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch in /Library gefunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También encontrado en /Library"
          }
        },
