    "Force quit %@?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sofort beenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Forzar salida de %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer %@ à quitter ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を強制終了しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要强制退出 %@ 吗？"
          }
        }
      }
    },
    "Force quitting stops the app immediately. Anything you haven’t saved in it will be lost. Try Quit first if the app is still responding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort beenden stoppt die App sofort. Alles, was du darin nicht gesichert hast, geht verloren. Versuche zuerst „Beenden“, wenn die App noch reagiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar la salida detiene la app de inmediato. Se perderá todo lo que no hayas guardado en ella. Prueba primero Salir si la app aún responde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer à quitter arrête l’app immédiatement. Tout ce que vous n’avez pas enregistré sera perdu. Essayez d’abord Quitter si l’app répond encore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強制終了すると App はただちに停止し、保存していない内容はすべて失われます。App がまだ応答する場合は、先に「終了」を試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制退出会立即停止 App，其中所有未存储的内容都将丢失。如果 App 仍有响应，请先尝试“退出”。"
          }
        }
      }
    },
    "Forgets cached website addresses, so name lookups start fresh. Helps when a site moved or won't load after a network change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergisst zwischengespeicherte Website-Adressen, sodass Namensauflösungen neu beginnen. Hilft, wenn eine Website umgezogen ist oder nach einem Netzwerkwechsel nicht lädt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida las direcciones de sitios web en caché para que las búsquedas de nombres empiecen de cero. Ayuda cuando un sitio se ha movido o no carga tras un cambio de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublie les adresses de sites web en cache pour que les résolutions de noms repartent de zéro. Utile quand un site a déménagé ou ne se charge plus après un changement de réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされた Web サイトのアドレスを消去し、名前解決をやり直します。サイトが移転したときや、ネットワークを変えた後にサイトが読み込めないときに役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除缓存的网站地址，让域名解析重新开始。适用于网站迁移或网络更改后无法载入的情况。"
          }
        }
      }
    },
