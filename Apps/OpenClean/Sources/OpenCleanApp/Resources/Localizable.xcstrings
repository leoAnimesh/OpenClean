          }
        }
      }
    },
    "Apps move to quarantine with their leftovers, so you can restore them for %lld days.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Apps kommen mit ihren Resten in die Quarantäne, sodass du sie %lld Tag lang wiederherstellen kannst."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Apps kommen mit ihren Resten in die Quarantäne, sodass du sie %lld Tage lang wiederherstellen kannst."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Apps move to quarantine with their leftovers, so you can restore them for %lld day."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Apps move to quarantine with their leftovers, so you can restore them for %lld days."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Las apps van a cuarentena con sus restos, así que puedes restaurarlas durante %lld día."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Las apps van a cuarentena con sus restos, así que puedes restaurarlas durante %lld días."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les apps vont en quarantaine avec leurs restes : vous pouvez les restaurer pendant %lld jour."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les apps vont en quarantaine avec leurs restes : vous pouvez les restaurer pendant %lld jours."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "App は残りファイルとともに隔離へ移動するため、%lld 日間復元できます。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "App 会连同其残留文件一起移入隔离区，因此你可以在 %lld 天内恢复它们。"
                }
              }
            }
          }
        }
      }
    },
    "Apps that are running, changed since the list was loaded, or in use are skipped automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die geöffnet sind, sich seit dem Laden der Liste geändert haben oder in Benutzung sind, werden automatisch übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que están en ejecución, que han cambiado desde que se cargó la lista o que están en uso se omiten automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ouvertes, modifiées depuis le chargement de la liste ou en cours d’utilisation sont ignorées automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の App、一覧の読み込み後に変更された App、使用中の App は自動的にスキップされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行、自列表载入后已更改或正在使用的 App 会被自动跳过。"
          }
        }
      }
    },
