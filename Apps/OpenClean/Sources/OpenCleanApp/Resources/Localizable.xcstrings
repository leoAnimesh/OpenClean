        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
