    "Apps and processes using the most CPU, GPU and memory right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps und Prozesse, die gerade am meisten CPU, GPU und Speicher nutzen."
