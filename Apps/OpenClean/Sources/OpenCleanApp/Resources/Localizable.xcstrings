          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactivó el Acceso total al disco. Vuelve un paso atrás para permitirlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Accès complet au disque a été désactivé. Revenez d’une étape pour l’autoriser à nouveau."
          }
        },
        "ja": {
