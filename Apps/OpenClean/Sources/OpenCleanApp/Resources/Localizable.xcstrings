    "Skipped while %@ is running. Quit it and scan again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersprungen, solange %@ geöffnet ist. Beende die App und scanne erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido mientras %@ esté en ejecución. Ciérrala y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré tant que %@ est ouvert. Quittez-le et relancez l’analyse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の実行中はスキップします。終了してからもう一度スキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 运行时会跳过。请退出它后再次扫描。"
          }
        }
      }
    },
    "Smart Scan": {
      "localizations": {
