    "Spotlight is rebuilding its index in the background. Search results fill in as it goes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight baut seinen Index im Hintergrund neu auf. Suchergebnisse füllen sich nach und nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight está reconstruyendo su índice en segundo plano. Los resultados de búsqueda irán apareciendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight reconstruit son index en arrière-plan. Les résultats de recherche se complètent au fur et à mesure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight はバックグラウンドでインデックスを再構築しています。検索結果は順次表示されるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight 正在后台重建索引。搜索结果会逐步补全。"
          }
        }
      }
    },
