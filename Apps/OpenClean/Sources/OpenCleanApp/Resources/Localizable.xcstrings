    "Looks through your home folder for big files, like videos, disk images and installers. ~/Library and apps are left out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht deinen Benutzerordner nach großen Dateien wie Videos, Disk-Images und Installationsprogrammen. ~/Library und Apps werden ausgelassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca archivos grandes en tu carpeta de inicio, como vídeos, imágenes de disco e instaladores. Se excluyen ~/Library y las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourt votre dossier de départ à la recherche de gros fichiers, comme des vidéos, images disque et programmes d’installation. ~/Library et les apps sont exclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダから、ビデオ、ディスクイメージ、インストーラなどの大きなファイルを探します。~/Library と App は対象外です。"
