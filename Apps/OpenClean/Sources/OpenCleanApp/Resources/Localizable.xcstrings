    },
    "Smart Scan looks for caches, logs and leftovers. Nothing is removed until you review it, and quarantined items can be restored for %lld days.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan sucht nach Caches, Protokollen und Resten. Nichts wird entfernt, bevor du es geprüft hast, und Objekte in Quarantäne lassen sich %lld Tag lang wiederherstellen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan sucht nach Caches, Protokollen und Resten. Nichts wird entfernt, bevor du es geprüft hast, und Objekte in Quarantäne lassen sich %lld Tage lang wiederherstellen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan looks for caches, logs and leftovers. Nothing is removed until you review it, and quarantined items can be restored for %lld day."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan looks for caches, logs and leftovers. Nothing is removed until you review it, and quarantined items can be restored for %lld days."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan busca cachés, registros y restos. No se elimina nada hasta que lo revises, y los ítems en cuarentena se pueden restaurar durante %lld día."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan busca cachés, registros y restos. No se elimina nada hasta que lo revises, y los ítems en cuarentena se pueden restaurar durante %lld días."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan recherche les caches, journaux et restes. Rien n’est supprimé avant que vous ne l’ayez vérifié, et les éléments en quarantaine peuvent être restaurés pendant %lld jour."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan recherche les caches, journaux et restes. Rien n’est supprimé avant que vous ne l’ayez vérifié, et les éléments en quarantaine peuvent être restaurés pendant %lld jours."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan はキャッシュ、ログ、残りファイルを探します。確認するまで何も削除されず、隔離された項目は %lld 日間復元できます。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Smart Scan 会查找缓存、日志和残留文件。在你检查之前不会移除任何内容，隔离区中的项目可在 %lld 天内恢复。"
                }
              }
            }
          }
        }
      }
    },
    "Some rule packs were skipped": {
      "localizations": {
