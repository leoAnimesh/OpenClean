    "Open in another app. Quit the app, then scan again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer anderen App geöffnet. Beende die App und scanne dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está abierto en otra app. Cierra la app y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvert dans une autre app. Quittez l’app, puis relancez l’analyse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの App で開かれています。App を終了してから、もう一度スキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在其他 App 中打开。请退出该 App，然后再次扫描。"
          }
        }
      }
    },
    "OpenClean couldn't check whether another app had it open, so it left it alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean konnte nicht prüfen, ob eine andere App es geöffnet hatte, und hat es daher in Ruhe gelassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean no pudo comprobar si otra app lo tenía abierto, así que no lo tocó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean n’a pas pu vérifier si une autre app l’avait ouvert, il n’y a donc pas touché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean はほかの App が開いているかどうかを確認できなかったため、そのままにしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 无法确认是否有其他 App 打开了它，因此未做处理。"
          }
        }
      }
    },
    "OpenClean couldn't reach GitHub (%@). Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean konnte GitHub nicht erreichen (%@). Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean no pudo conectar con GitHub (%@). Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean n’a pas pu joindre GitHub (%@). Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean は GitHub に接続できませんでした（%@）。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClean 无法连接 GitHub（%@）。请检查网络连接后重试。"
          }
        }
      }
    },
