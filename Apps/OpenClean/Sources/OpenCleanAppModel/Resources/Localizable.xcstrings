    "System items can only be deleted, not moved to quarantine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemobjekte können nur gelöscht, nicht in die Quarantäne bewegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems del sistema solo se pueden eliminar, no mover a cuarentena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments système peuvent seulement être supprimés, pas placés en quarantaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム項目は削除のみ可能で、隔離へは移動できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统项目只能删除，不能移入隔离区。"
          }
        }
      }
    },
    "That folder can't be scanned. It may have been moved or deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner kann nicht gescannt werden. Möglicherweise wurde er bewegt oder gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa carpeta no se puede analizar. Puede que se haya movido o eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier ne peut pas être analysé. Il a peut-être été déplacé ou supprimé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダはスキャンできません。移動または削除された可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法扫描该文件夹。它可能已被移动或删除。"
          }
        }
      }
    },
    "The administrator password prompt was cancelled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abfrage des Administratorpassworts wurde abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló la solicitud de la contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande du mot de passe administrateur a été annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者パスワードの確認がキャンセルされました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员密码提示已被取消。"
          }
        }
      }
    },
    "The app wasn't moved, so this was left in place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde nicht bewegt, daher blieb dies an seinem Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no se movió, así que esto se quedó donde estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas été déplacée : cet élément est donc resté en place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App が移動されなかったため、これはそのまま残しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 App 未被移动，因此此项目保留在原处。"
          }
        }
      }
    },
    "Too many system items for one password prompt. Clean again to remove the rest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Systemobjekte für eine Passwortabfrage. Bereinige erneut, um den Rest zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados ítems del sistema para una sola solicitud de contraseña. Vuelve a limpiar para eliminar el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d’éléments système pour une seule demande de mot de passe. Relancez le nettoyage pour supprimer le reste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回のパスワード確認で扱えるシステム項目の数を超えています。残りを削除するには、もう一度クリーンアップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统项目过多，一次密码提示无法全部处理。请再次清理以移除其余项目。"
          }
        }
      }
    },
