{
  "sourceLanguage": "en",
  "strings": {
    "%@ is turned off and won't start again until you turn it on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ausgeschaltet und startet erst wieder, wenn du es einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivado y no volverá a iniciarse hasta que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est désactivé et ne redémarrera pas tant que vous ne l’aurez pas activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はオフになり、オンにするまで起動しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已关闭，在你打开它之前不会再次启动。"
          }
        }
      }
    },
    "%@ is turned on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist eingeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をオンにしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已打开。"
          }
        }
      }
    },
    "%@ was moved to quarantine. You can restore it from History for %lld days; it loads again at your next login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde in die Quarantäne bewegt. Du kannst es %#@days@ lang aus dem Verlauf wiederherstellen; es wird bei deiner nächsten Anmeldung wieder geladen."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tage"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was moved to quarantine. You can restore it from History for %#@days@; it loads again at your next login."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se movió a cuarentena. Puedes restaurarlo desde el Historial durante %#@days@; se cargará de nuevo en tu próximo inicio de sesión."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg día"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a été placé en quarantaine. Vous pouvez le restaurer depuis l’Historique pendant %#@days@ ; il se recharge à votre prochaine ouverture de session."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg jour"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg jours"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を隔離へ移動しました。%#@days@は履歴から復元でき、次回のログイン時に再び読み込まれます。"
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 日間"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已移入隔离区。你可以在 %#@days@内从“历史记录”恢复它；它会在你下次登录时再次载入。"
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 天"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ was running. Quit it, then scan again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war geöffnet. Beende die App und scanne dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estaba en ejecución. Ciérrala y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ était ouvert. Quittez-le, puis relancez l’analyse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が実行中でした。終了してから、もう一度スキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当时正在运行。请退出它，然后再次扫描。"
          }
        }
      }
    },
    "%lld items were left in place": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Objekt ist an seinem Ort geblieben"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Objekte sind an ihrem Ort geblieben"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item was left in place"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items were left in place"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ítem se quedó donde estaba"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ítems se quedaron donde estaban"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld élément est resté en place"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld éléments sont restés en place"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 項目はそのまま残りました"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "有 %lld 个项目保留在原处"
                }
              }
            }
          }
        }
      }
    },
    "A background Smart Scan found it. Nothing was removed; open OpenClean to review and clean.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Smart Scan im Hintergrund hat das gefunden. Es wurde nichts entfernt; öffne OpenClean, um zu prüfen und zu bereinigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo encontró un Smart Scan en segundo plano. No se eliminó nada; abre OpenClean para revisar y limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Smart Scan en arrière-plan l’a trouvé. Rien n’a été supprimé ; ouvrez OpenClean pour vérifier et nettoyer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドの Smart Scan で見つかりました。何も削除されていません。OpenClean を開いて確認し、クリーンアップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台 Smart Scan 发现了这些内容。未移除任何内容；打开 OpenClean 进行检查和清理。"
          }
        }
      }
    },
    "A folder above it isn't protected by macOS, so it wasn't removed as administrator.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein übergeordneter Ordner ist nicht von macOS geschützt, daher wurde es nicht als Administrator entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta superior no está protegida por macOS, así que no se eliminó como administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier parent n’est pas protégé par macOS : il n’a donc pas été supprimé en tant qu’administrateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上位のフォルダが macOS で保護されていないため、管理者として削除しませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其上层文件夹不受 macOS 保护，因此未以管理员身份移除。"
          }
        }
      }
    },
    "About %@ can be cleaned": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %@ können bereinigt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden limpiar unos %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ peuvent être nettoyés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ をクリーンアップできます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@ 可清理"
          }
        }
      }
    },
    "All set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo listo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est prêt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切就绪"
          }
        }
      }
    },
    "Already gone. Something else removed it after the scan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits weg. Etwas anderes hat es nach dem Scan entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no está. Otra cosa lo eliminó después del análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà disparu. Autre chose l’a supprimé après l’analyse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにありません。スキャン後にほかのものが削除しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已不存在。扫描后有其他程序移除了它。"
          }
        }
      }
    },
