    "Changed since the scan; an app may be using it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit dem Scan geändert; möglicherweise nutzt es eine App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha cambiado desde el análisis; puede que una app lo esté usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié depuis l’analyse ; une app l’utilise peut-être."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン後に変更されました。App が使用している可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自扫描后已更改；可能有 App 正在使用它。"
          }
        }
      }
    },
    "Could not save settings: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen konnten nicht gesichert werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los ajustes: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les réglages : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存できませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储设置：%@"
          }
        }
      }
    },
    "Couldn't be removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht entfernt werden."
