    "In a protected location. OpenClean never removes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An einem geschützten Ort. OpenClean entfernt es nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en una ubicación protegida. OpenClean nunca lo elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un emplacement protégé. OpenClean ne le supprime jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護された場所にあります。OpenClean が削除することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于受保护的位置。OpenClean 绝不会移除它。"
          }
        }
      }
    },
    "Its path can't be passed safely to the administrator prompt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Pfad kann nicht sicher an die Administratorabfrage übergeben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ruta no se puede pasar de forma segura a la solicitud de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son chemin ne peut pas être transmis en toute sécurité à la demande d’administrateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのパスは管理者の確認画面に安全に渡せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其路径无法安全地传递给管理员提示。"
          }
        }
      }
    },
